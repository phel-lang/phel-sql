(in-ns phel.sql)

(defn- emit-update      [t] (prefixed "UPDATE"      (ident+ t)))
(defn- emit-delete-from [t] (prefixed "DELETE FROM" (ident+ t)))
(defn- emit-insert-into [t] (prefixed "INSERT INTO" (ident+ t)))

(defn- sorted-keys [m]
  (sort (fn [a b] (php/strcmp (name a) (name b))) (keys m)))

(defn- emit-assignments
  "`col = ?, ...` in key order for a non-empty `{column value}` map. `clause` names the caller in errors."
  [clause m]
  (when-not (map? m) (bad-arg (str clause " expects a map, got: " (show m))))
  (when (zero? (count m)) (bad-arg (str clause " expects at least one assignment")))
  (let [parts (map (fn [k]
                     (let [[v-sql v-params] (operand (get m k))]
                       [(str (ident k) " = " v-sql) v-params]))
                   (sorted-keys m))]
    [(str/join ", " (sqls-of parts)) (params-of parts)]))

(defn- emit-set [m]
  (prefixed "SET" (emit-assignments "set" m)))

(defn- emit-columns [cols]
  [(str "(" (str/join ", " (map ident (non-empty-vector! :columns cols))) ")") []])

(defn- row-placeholders [row]
  (str "(" (str/join ", " (map (fn [_] "?") row)) ")"))

(defn- check-keys-in-columns! [rendered column-names]
  (let [allowed (set column-names)
        unknown (filter (fn [k] (not (contains? allowed (get rendered k)))) (keys rendered))]
    (when (seq unknown)
      (bad-arg (str "values map key(s) not listed in :columns: "
                    (str/join ", " (map show unknown)))))))

(defn- row-values-by-name
  "Values of `row` for each of `column-names`, matching keys by their rendered
   identifier. `rendered` maps every key used in any row to that identifier, so
   it is computed once per statement. A name the row lacks gives nil."
  [row column-names rendered]
  (let [by-name (into {} (map (fn [k] [(get rendered k) (get row k)]) (keys row)))]
    (vec (map (fn [name] (get by-name name)) column-names))))

(defn- check-rows-not-empty! [rows]
  (when (some (fn [r] (zero? (count r))) rows)
    (bad-arg "values rows must not be empty")))

(defn- check-vector-row-widths! [rows expected-width]
  (let [widths (distinct (map count rows))]
    (when (and (nil? expected-width) (> (count widths) 1))
      (bad-arg (str "values rows must all have the same width, got: "
                    (str/join ", " (map str widths)))))
    (when (and expected-width (some (fn [w] (not= w expected-width)) widths))
      (bad-arg (str "values row width must equal the " expected-width " :columns, got: "
                    (str/join ", " (map str widths)))))))

(defn- values-sql-and-params [rows]
  {:values-sql (str "VALUES " (str/join ", " (map row-placeholders rows)))
   :params     (vec (mapcat identity rows))})

(defn- sort-by-name [ks]
  (vec (sort (fn [a b] (php/strcmp (name a) (name b))) ks)))

(defn- unique-key-per-column
  "The one key that renders as each of `column-names`, or nil when a name is
   spelled by more than one key (then rows must be matched by name)."
  [column-names rendered row-keys]
  (let [keys-by-name (group-by (fn [k] (get rendered k)) row-keys)]
    (when (every? (fn [n] (<= (count (get keys-by-name n)) 1)) column-names)
      (mapv (fn [n] (first (get keys-by-name n))) column-names))))

(defn- map-row-values
  "Values of each map row, in `column-names` order."
  [vs column-names rendered row-keys]
  (if-let [column-keys (unique-key-per-column column-names rendered row-keys)]
    (map (fn [r] (vec (map (fn [k] (when k (get r k))) column-keys))) vs)
    (map (fn [r] (row-values-by-name r column-names rendered)) vs)))

(defn- normalise-map-rows [vs explicit-cols]
  (check-rows-not-empty! vs)
  (let [row-keys     (distinct (mapcat keys vs))
        rendered     (into {} (map (fn [k] [k (ident k)]) row-keys))
        column-names (if explicit-cols
                       (mapv ident explicit-cols)
                       (mapv ident (sort-by-name row-keys)))]
    (when explicit-cols
      (check-keys-in-columns! rendered column-names))
    (assoc (values-sql-and-params (map-row-values vs column-names rendered row-keys))
           :columns-sql (str "(" (str/join ", " column-names) ")"))))

(defn- normalise-vector-rows [vs explicit-cols]
  (check-rows-not-empty! vs)
  (check-vector-row-widths! vs (when explicit-cols (count explicit-cols)))
  (assoc (values-sql-and-params vs) :columns-sql nil))

(defn- normalise-values
  "Returns {:columns-sql ... :values-sql ... :params [...]}.
   For map rows, columns are `explicit-cols` when given, else the union of
   keys (alphabetical for stability), and columns-sql is included. For vector
   rows, columns-sql is nil."
  [vs explicit-cols]
  (when-not (and (vector? vs) (seq vs))
    (bad-arg "values expects a non-empty vector"))
  (cond
    (every? map? vs)    (normalise-map-rows vs explicit-cols)
    (every? vector? vs) (normalise-vector-rows vs explicit-cols)
    :else               (bad-arg "values items must all be vectors or all be maps")))
