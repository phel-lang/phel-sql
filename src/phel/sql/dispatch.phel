(in-ns phel.sql)

;; ===========================================================================
;; Per-statement clause dispatch
;; ===========================================================================

(def- select-emitters
  {:with               emit-with
   :with-recursive     emit-with-recursive
   :select             emit-select
   :select-distinct    emit-select-distinct
   :select-distinct-on emit-select-distinct-on
   :from               emit-from
   :join               emit-join
   :left-join          emit-left-join
   :right-join         emit-right-join
   :full-join          emit-full-join
   :cross-join         emit-cross-join
   :where              emit-where-clause
   :group-by           emit-group-by
   :having             emit-having-clause
   :window             emit-window
   :order-by           emit-order-by
   :limit              emit-limit
   :offset             emit-offset
   :for                emit-for
   :returning          emit-returning})

(def- select-order
  [:with :with-recursive
   :select :select-distinct :select-distinct-on
   :from :join :left-join :right-join :full-join :cross-join
   :where :group-by :having :window
   :order-by :limit :offset
   :for :returning])

(def- update-emitters
  {:with            emit-with
   :with-recursive  emit-with-recursive
   :update          emit-update
   :set             emit-set
   :from            emit-from
   :where           emit-update-where-clause
   :order-by        emit-order-by
   :limit           emit-limit
   :returning       emit-returning})

(def- update-order
  [:with :with-recursive :update :set :from :where :order-by :limit :returning])

(def- delete-emitters
  {:with            emit-with
   :with-recursive  emit-with-recursive
   :delete-from     emit-delete-from
   :where           emit-delete-where-clause
   :order-by        emit-order-by
   :limit           emit-limit
   :returning       emit-returning})

(def- delete-order
  [:with :with-recursive :delete-from :where :order-by :limit :returning])

(def- set-op-keywords #{:union :union-all :intersect :except})

(def- set-op-sql
  {:union      "UNION"
   :union-all  "UNION ALL"
   :intersect  "INTERSECT"
   :except     "EXCEPT"})

;; ===========================================================================
;; Helpers
;; ===========================================================================

(defn- mutex-select-mode! [query]
  (let [modes   [:select :select-distinct :select-distinct-on]
        present (filter (fn [k] (contains? query k)) modes)]
    (when (> (count present) 1)
      (bad-arg (str "Only one of " (str/join " / " (map name modes))
                    " may be present, got: " (str/join ", " (map name present)))))))

(defn- statement-type [query]
  (cond
    (some (fn [k] (contains? query k)) set-op-keywords)                                                                                                                                                                    :set-op
    (contains? query :insert-into)                                                                                                                                                                                         :insert
    (contains? query :update)                                                                                                                                                                                              :update
    (contains? query :delete-from)                                                                                                                                                                                         :delete
    (and (contains? query :values)
         (not (contains? query :select))
         (not (contains? query :select-distinct))
         (not (contains? query :select-distinct-on))
         (not (contains? query :from))) :values-only
    :else                                                                                                                                                                                                                  :select))

(def- select-allowed (set select-order))
(def- update-allowed (set update-order))
(def- delete-allowed (set delete-order))

(defn- check-unknown! [query allowed]
  (let [unknown (->> (keys query)
                     (filter (fn [k] (not (contains? allowed k)))))]
    (when (seq unknown)
      (bad-arg (str "Unknown clause(s) for this statement: "
                    (str/join ", " (map (fn [k] (str (name k) (did-you-mean k allowed))) unknown)))))))

(defn- emit-ordered [query emitters clause-order allowed]
  (check-unknown! query allowed)
  (let [present (filter (fn [k] (contains? query k)) clause-order)
        parts   (remove (fn [p] (= omitted-clause p))
                        (map (fn [k] (in-clause k (fn [] ((get emitters k) (get query k))))) present))]
    [(str/join " " (sqls-of parts)) (vec (params-of parts))]))

(defn- emit-select-stmt [q]
  (mutex-select-mode! q)
  (emit-ordered q select-emitters select-order select-allowed))

(defn- emit-update-stmt [q]
  (when-not (contains? q :set) (bad-arg "update statement requires :set"))
  (emit-ordered q update-emitters update-order update-allowed))
(defn- emit-delete-stmt [q] (emit-ordered q delete-emitters delete-order delete-allowed))

(def- insert-allowed
  #{:with :with-recursive :insert-into :columns :values :query :returning
    :on-conflict :on-conflict-where :do-nothing :do-update-set :do-update-where
    :on-duplicate-key-update})

(defn- check-insert-query!
  "`:query` must be a SELECT, set-op or VALUES query with vector rows."
  [q]
  (when-not (map? q)
    (bad-arg (str ":query expects a map, got: " (show q))))
  (case (statement-type q)
    :set-op      nil
    :values-only (when (some map? (get q :values))
                   (bad-arg (str ":query VALUES rows must be vectors (use :columns to name them), got: " (show q))))
    :select      (when-not (some (fn [k] (contains? q k)) [:select :select-distinct :select-distinct-on])
                   (bad-arg (str ":query expects a SELECT, VALUES or set operation, got: " (show q))))
    (bad-arg (str ":query expects a SELECT, VALUES or set operation, got: " (show q)))))

(defn- check-insert-source! [query]
  (let [values? (contains? query :values)
        query?  (contains? query :query)]
    (when (and values? query?)
      (bad-arg (str ":values and :query are mutually exclusive, got both: "
                    (show (get query :values)) " and " (show (get query :query)))))
    (when-not (or values? query?)
      (bad-arg "insert statement requires :values or :query"))
    (when query?
      (check-insert-query! (get query :query)))))

(defn- insert-source
  "`{:source-sql :params :columns-sql}` for the `:values` rows or the `:query` subquery."
  [query]
  (if (contains? query :query)
    (let [[sql params] (in-clause :query (fn [] (compile-query (get query :query))))]
      {:source-sql sql :params params :columns-sql nil})
    (let [vs (in-clause :values (fn [] (normalise-values (get query :values) (get query :columns))))]
      {:source-sql (get vs :values-sql) :params (get vs :params) :columns-sql (get vs :columns-sql)})))

(defn- emit-insert-stmt [query]
  (check-unknown! query insert-allowed)
  (when-not (contains? query :insert-into) (bad-arg "insert statement requires :insert-into"))
  (check-insert-source! query)
  (check-upsert-keys! query)
  (when (contains? query :columns)
    (in-clause :columns (fn [] (non-empty-vector! :columns (get query :columns)))))
  (when (and (contains? query :on-conflict) (contains? query :on-duplicate-key-update))
    (bad-arg ":on-conflict and :on-duplicate-key-update are mutually exclusive"))
  (let [src               (insert-source query)
        columns-sql       (cond
                            (contains? query :columns) (first (in-clause :columns (fn [] (emit-columns (get query :columns)))))
                            :else                      (get src :columns-sql))
        head              (cond-> []
                                  (contains? query :with)           (conj (in-clause :with (fn [] (emit-with (get query :with)))))
                                  (contains? query :with-recursive) (conj (in-clause :with-recursive (fn [] (emit-with-recursive (get query :with-recursive))))))
        body              [(in-clause :insert-into (fn [] (emit-insert-into (get query :insert-into))))]
        conflict          (in-clause :on-conflict (fn [] (emit-on-conflict-block query)))
        odku              (when (contains? query :on-duplicate-key-update)
                            (in-clause :on-duplicate-key-update
                                       (fn [] (emit-on-duplicate-key-update (get query :on-duplicate-key-update)))))
        tail              (cond-> []
                                  conflict (conj conflict)
                                  odku     (conj odku)
                                  (contains? query :returning) (conj (in-clause :returning (fn [] (emit-returning (get query :returning))))))
        leading-fragments (concat head body)
        leading-sql       (str/join " " (sqls-of leading-fragments))
        leading-params    (vec (params-of leading-fragments))
        tail-sql          (str/join " " (sqls-of tail))
        tail-params       (vec (params-of tail))
        all-sql           (str/join " "
                                    (filter (fn [s] (not (empty? s)))
                                            [leading-sql
                                             columns-sql
                                             (get src :source-sql)
                                             tail-sql]))]
    [all-sql (vec (concat leading-params (get src :params) tail-params))]))

(defn- emit-values-stmt [query]
  (check-unknown! query #{:values})
  (let [vs (normalise-values (get query :values) nil)]
    [(get vs :values-sql) (get vs :params)]))

(defn- find-set-op [query]
  (first (filter (fn [k] (contains? query k)) set-op-keywords)))

(def- set-op-wrapper-emitters
  {:with           emit-with
   :with-recursive emit-with-recursive
   :order-by       emit-order-by
   :limit          emit-limit
   :offset         emit-offset})

(def- set-op-head-order [:with :with-recursive])
(def- set-op-tail-order [:order-by :limit :offset])

(defn- emit-set-op-wrapper [query clause-order]
  (->> clause-order
       (filter (fn [k] (contains? query k)))
       (map (fn [k] (in-clause k (fn [] ((get set-op-wrapper-emitters k) (get query k))))))))

(defn- emit-set-op-stmt [query]
  (let [op     (find-set-op query)
        extras (filter (fn [k] (and (not= k op) (not (contains? set-op-wrapper-emitters k))))
                       (keys query))]
    (when (seq extras)
      (bad-arg (str "set-op query supports only one of "
                    (str/join "/" (map name set-op-keywords))
                    " plus the wrapper keys "
                    (str/join ", " (map name (concat set-op-head-order set-op-tail-order)))
                    ", got extras: " (str/join ", " (map name extras)))))
    (when (and (contains? query :with) (contains? query :with-recursive))
      (bad-arg "set-op query accepts only one of with/with-recursive"))
    (let [queries (get query op)]
      (when-not (and (vector? queries) (>= (count queries) 2))
        (bad-arg (str (name op) " expects a vector of at least two queries")))
      (let [head  (emit-set-op-wrapper query set-op-head-order)
            parts (map (fn [q] (in-clause op (fn [] (compile-query q)))) queries)
            body  [(str/join (str " " (get set-op-sql op) " ")
                             (map (fn [[s _]] (str "(" s ")")) parts))
                   (params-of parts)]
            tail  (emit-set-op-wrapper query set-op-tail-order)
            all   (concat head [body] tail)]
        [(str/join " " (sqls-of all)) (vec (params-of all))]))))

(defn- compile-query [query]
  (when-not (map? query)
    (bad-arg (str "format expects a map, got: " (show query))))
  (case (statement-type query)
    :set-op      (emit-set-op-stmt query)
    :insert      (emit-insert-stmt query)
    :update      (emit-update-stmt query)
    :delete      (emit-delete-stmt query)
    :values-only (emit-values-stmt query)
    :select      (emit-select-stmt query)))
