(in-ns phel.sql)
(def- expr-tags #{:raw :fn :cast :case :over :filter :lateral})

(def- grouping-tags #{:rollup :cube :grouping-sets})

(defn- grouping-form? [x] (and (vector? x) (contains? grouping-tags (first x))))
(defn- subquery? [x] (map? x))
(defn- tagged? [x] (and (vector? x) (keyword? (first x)) (contains? expr-tags (first x))))
(defn- raw? [x] (and (vector? x) (= :raw (first x)) (= 2 (count x))))

(def- identifier-segment "(?:[\\p{L}_$][\\p{L}\\p{N}_$]*|[0-9]+|\\*)")

(def- identifier-pattern (str "/^" identifier-segment "(?:\\." identifier-segment ")*$/Du"))

(defn- snake-case-hint [kw]
  (let [written (str/replace (subs (show kw) 1) "-" "_")
        valid?  (every? (fn [part] (= 1 (php/preg_match identifier-pattern part)))
                        (php/explode "/" written))]
    (if (and (php/str_contains (show kw) "-") valid?)
      (str " (did you mean :" written "?)")
      "")))

(defn- check-identifier!
  "Throws unless every dot-separated part of `text` is a plain name, a number or `*`."
  [kw text]
  (when-not (= 1 (php/preg_match identifier-pattern text))
    (bad-arg (str "Invalid identifier: " (show kw)
                  ". Use a string or [:raw ...] for names outside letters, digits, _ and $"
                  (snake-case-hint kw)))))

(defn- ident
  "Render a plain identifier (no params, no subquery).
    keyword         -> bare name (qualified -> 'schema.name'), validated
    string          -> literal escape hatch, rendered verbatim"
  [x]
  (cond
    (keyword? x) (let [ns (namespace x)]
                   (when ns (check-identifier! x ns))
                   (check-identifier! x (name x))
                   (if ns (str ns "." (name x)) (name x)))
    (string? x)  x
    :else        (bad-arg (str "Unsupported identifier: " (show x)))))

(defn- emit-aliased [x]
  (when-not (= 2 (count x))
    (bad-arg (str "alias expects [base alias], got: " (show x))))
  (let [[base alias]     x
        [b-sql b-params] (ident+ base)]
    [(str b-sql " AS " (ident alias)) b-params]))

(defn- ident+
  "Identifier with optional params. Accepts everything `ident` does, plus
    [:raw ...] / [:fn ...] / [:cast ...] / [:case ...] / [:over ...] /
    [:filter ...] / [:lateral ...]  -> tagged expression
    [base alias]    -> 'base AS alias'  (base may be any of the above or a subquery)
    subquery map    -> '(...)'"
  [x]
  (cond
    (tagged? x)        (emit-tagged x)
    (subquery? x)      (let [[s p] (compile-query x)] [(str "(" s ")") p])
    (grouping-form? x) (bad-arg (str (first x) " is only valid inside :group-by, got: " (show x)))
    (vector? x)        (emit-aliased x)
    :else              [(ident x) []]))

(defn- idents+ [xs]
  (let [parts (mapv ident+ xs)]
    [(str/join ", " (sqls-of parts)) (params-of parts)]))

(defn- emit-ident-list
  "`PREFIX a, b, c` for a clause whose value is a non-empty list of identifiers."
  [prefix clause xs]
  (prefixed prefix (idents+ (non-empty-vector! clause xs))))
