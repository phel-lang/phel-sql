(in-ns phel.sql)

(defn- bad-arg [msg]
  (throw (new \InvalidArgumentException msg)))

(defn- show [x] (pr-str x))

(defn- closest-candidate
  "The candidate closest to `input` by edit distance (1 for inputs of 3 characters
   or fewer, else 2). Ties go to the first candidate by name. Nil for other inputs."
  [input candidates]
  (when (or (keyword? input) (string? input))
    (let [wanted (if (keyword? input) (name input) input)
          limit  (if (<= (php/strlen wanted) 3) 1 2)
          scored (map (fn [c] [(php/levenshtein wanted (name c)) c])
                      (sort-by name candidates))
          near   (filter (fn [[dist _]] (<= dist limit)) scored)]
      (when (seq near)
        (second (reduce (fn [best cur] (if (< (first cur) (first best)) cur best)) near))))))

(defn- did-you-mean
  "` (did you mean :x?)` for the closest keyword in `candidates`, or an empty string."
  [input candidates]
  (if-let [c (closest-candidate input candidates)]
    (str " (did you mean " (show c) "?)")
    ""))

(defn- in-clause
  "Runs `f`. An InvalidArgumentException from it is rethrown as `in :clause: msg`.
   Inside nested clauses the path grows outward (`in :from > :where: msg`), a
   repeated adjacent clause is not added, and a message that starts with its own
   clause name drops it."
  [clause f]
  (try
    (f)
    (catch \InvalidArgumentException e
      (let [msg   (.getMessage e)
            label (show clause)
            split (when (php/str_starts_with msg "in :") (php/strpos msg ": "))]
        (throw
         (new \InvalidArgumentException
              (if split
                (let [path (php/substr msg 3 (- split 3))
                      rest (php/substr msg (+ split 2))]
                  (if (= label (get (php/explode " > " path) 0))
                    msg
                    (str "in " label " > " path ": " rest)))
                (let [own (str label " ")]
                  (str "in " label ": "
                       (if (php/str_starts_with msg own) (php/substr msg (php/strlen own)) msg))))
              0 e))))))

(defn- params-of [fragments] (vec (mapcat (fn [[_ p]] p) fragments)))
(defn- sqls-of   [fragments] (mapv first fragments))

(defn- prefixed [prefix [sql params]]
  [(str prefix " " sql) params])

(defn- non-empty-vector!
  "Returns `v` as a vector. Accepts any non-empty sequential collection."
  [clause v]
  (when-not (and (sequential? v) (seq v))
    (bad-arg (str clause " expects a non-empty vector or list, got: " (show v))))
  (vec v))
