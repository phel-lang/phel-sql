(in-ns phel.sql)

(defn- bad-arg [msg]
  (throw (new \InvalidArgumentException msg)))

(defn- show [x] (php/var_export x true))

(defn- params-of [fragments] (mapcat (fn [[_ p]] p) fragments))
(defn- sqls-of   [fragments] (map first fragments))

(defn- prefixed [prefix [sql params]]
  [(str prefix " " sql) params])

(defn- non-empty-vector! [clause v]
  (when-not (and (vector? v) (seq v))
    (bad-arg (str clause " expects a non-empty vector, got: " (show v))))
  v)
