(in-ns phel.sql)

(defn- bad-arg [msg]
  (throw (new \InvalidArgumentException msg)))

(defn- show [x] (pr-str x))

(defn- closest-candidate
  "The candidate within edit distance 2 of `input`, smallest first, ties by candidate order."
  [input candidates]
  (let [wanted (if (keyword? input) (name input) (str input))
        scored (map (fn [c] [(php/levenshtein wanted (name c)) c]) candidates)
        near   (filter (fn [[dist _]] (<= dist 2)) scored)]
    (when (seq near)
      (second (reduce (fn [best cur] (if (< (first cur) (first best)) cur best)) near)))))

(defn- did-you-mean
  "` (did you mean :x?)` for the closest keyword in `candidates`, or an empty string."
  [input candidates]
  (if-let [c (closest-candidate input candidates)]
    (str " (did you mean " (show c) "?)")
    ""))

(defn- in-clause
  "Runs `f`. An InvalidArgumentException from it gets an `in :clause: ` prefix,
   unless it already names an inner clause."
  [clause f]
  (try
    (f)
    (catch \InvalidArgumentException e
      (let [msg (.getMessage e)]
        (if (php/str_starts_with msg "in :")
          (throw e)
          (throw (new \InvalidArgumentException (str "in " (show clause) ": " msg) 0 e)))))))

(defn- params-of [fragments] (vec (mapcat (fn [[_ p]] p) fragments)))
(defn- sqls-of   [fragments] (mapv first fragments))

(defn- prefixed [prefix [sql params]]
  [(str prefix " " sql) params])

(defn- non-empty-vector!
  "Returns `v` as a vector. Accepts any non-empty sequential collection."
  [clause v]
  (when-not (and (sequential? v) (seq v))
    (bad-arg (str clause " expects a non-empty vector or list, got: " (show v))))
  (vec v))
