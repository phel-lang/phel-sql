(in-ns phel.sql)

;; ===========================================================================
;; Simple SELECT-side clauses
;; ===========================================================================

(defn- emit-select          [cols] (emit-ident-list "SELECT"          :select          cols))
(defn- emit-select-distinct [cols] (emit-ident-list "SELECT DISTINCT" :select-distinct cols))
(defn- emit-from            [xs]   (emit-ident-list "FROM"            :from            xs))
(defn- nested-grouping-error [x]
  (bad-arg (str "Nested " (first x) " is not allowed inside :rollup, :cube or a grouping set, got: " (show x))))

(defn- emit-rollup-item
  "A plain untagged vector inside ROLLUP / CUBE is a composite column list."
  [x]
  (cond
    (grouping-form? x)                  (nested-grouping-error x)
    (and (vector? x) (not (tagged? x))) (let [[sql params] (idents+ x)] [(str "(" sql ")") params])
    :else                               (ident+ x)))

(defn- emit-set-item [x]
  (if (grouping-form? x) (nested-grouping-error x) (ident+ x)))

(defn- emit-grouping-set [set]
  (cond
    (grouping-form? set) (emit-grouping-form set)
    (sequential? set)    (let [parts (mapv emit-set-item set)]
                           [(str "(" (str/join ", " (sqls-of parts)) ")") (params-of parts)])
    :else                (bad-arg (str ":grouping-sets expects each set to be a vector or list, got: " (show set)))))

(defn- emit-grouping-form [form]
  (let [tag   (first form)
        items (vec (rest form))]
    (if (= :grouping-sets tag)
      (do
        (when (empty? items)
          (bad-arg (str ":grouping-sets expects at least one set, got: " (show form))))
        (let [parts (mapv emit-grouping-set items)]
          [(str "GROUPING SETS (" (str/join ", " (sqls-of parts)) ")") (params-of parts)]))
      (do
        (when (empty? items)
          (bad-arg (str tag " expects at least one column, got: " (show form))))
        (let [parts (mapv emit-rollup-item items)]
          [(str (if (= :rollup tag) "ROLLUP" "CUBE") " (" (str/join ", " (sqls-of parts)) ")") (params-of parts)])))))

(defn- emit-group-by [cols]
  (let [parts (mapv (fn [x] (if (grouping-form? x) (emit-grouping-form x) (ident+ x)))
                    (non-empty-vector! :group-by cols))]
    [(str "GROUP BY " (str/join ", " (sqls-of parts))) (params-of parts)]))
(defn- emit-returning       [cols] (emit-ident-list "RETURNING"       :returning       cols))
(defn- emit-optional-where [prefix w]
  (when-let [emitted (emit-where-or-nil w)]
    (prefixed prefix emitted)))

(defn- emit-mutation-where [kind w]
  (or (emit-optional-where "WHERE" w)
      (bad-arg (str kind " statement has an empty :where; omit :where to " kind " every row"))))

(defn- emit-where-clause    [w]    (emit-optional-where "WHERE" w))
(defn- emit-update-where-clause [w] (emit-mutation-where "update" w))
(defn- emit-delete-where-clause [w] (emit-mutation-where "delete" w))
(defn- emit-having-clause   [w]    (emit-optional-where "HAVING" w))

;; ===========================================================================
;; WINDOW
;; ===========================================================================

(defn- emit-named-window [pair]
  (when-not (and (vector? pair) (= 2 (count pair)))
    (bad-arg (str ":window entries must be [name spec] pairs, got: " (show pair))))
  (let [[w-name spec] pair]
    (when-not (or (keyword? w-name) (string? w-name))
      (bad-arg (str "window name must be a keyword or string, got: " (show w-name))))
    (when-not (map? spec)
      (bad-arg (str ":window expects a window-spec map, got: " (show spec))))
    (let [[s p] (emit-window-spec spec)]
      [(str (ident w-name) " AS (" s ")") p])))

(defn- emit-window [windows]
  (let [parts (map emit-named-window (non-empty-vector! :window windows))]
    [(str "WINDOW " (str/join ", " (sqls-of parts))) (params-of parts)]))

(defn- emit-select-distinct-on [spec]
  (when-not (map? spec)
    (bad-arg ":select-distinct-on expects {:on [...] :select [...]}"))
  (let [on-cols  (get spec :on)
        sel-cols (get spec :select)
        allowed  #{:on :select}
        unknown  (filter (fn [k] (not (contains? allowed k))) (keys spec))]
    (when (seq unknown)
      (bad-arg (str "Unknown :select-distinct-on key(s): " (str/join ", " (map name unknown)))))
    (when-not (and (vector? on-cols) (seq on-cols))
      (bad-arg ":select-distinct-on requires a non-empty :on vector"))
    (when-not (and (vector? sel-cols) (seq sel-cols))
      (bad-arg ":select-distinct-on requires a non-empty :select vector"))
    (let [[on-sql on-params]   (idents+ on-cols)
          [sel-sql sel-params] (idents+ sel-cols)]
      [(str "SELECT DISTINCT ON (" on-sql ") " sel-sql)
       (concat on-params sel-params)])))

;; ===========================================================================
;; LIMIT / OFFSET / FOR
;; ===========================================================================

(defn- non-neg-int! [n clause]
  (when-not (and (int? n) (>= n 0))
    (bad-arg (str clause " must be a non-negative integer, got: " (show n)))))

(defn- emit-limit  [n] (non-neg-int! n "limit")  [(str "LIMIT " n)  []])
(defn- emit-offset [n] (non-neg-int! n "offset") [(str "OFFSET " n) []])

(def- for-modes
  {:update        "UPDATE"
   :share         "SHARE"
   :no-key-update "NO KEY UPDATE"
   :key-share     "KEY SHARE"})

(def- for-locks
  {:nowait      "NOWAIT"
   :skip-locked "SKIP LOCKED"})

(defn- emit-for [spec]
  (when (and (vector? spec) (not (<= 1 (count spec) 2)))
    (bad-arg (str "for expects a mode or [mode lock], got: " (show spec))))
  (let [[mode lock] (if (vector? spec) spec [spec nil])
        mode-sql    (or (get for-modes mode)
                        (bad-arg (str "for mode must be one of "
                                      (str/join ", " (map name (keys for-modes)))
                                      ", got: " (show mode))))
        lock-sql    (when lock
                      (or (get for-locks lock)
                          (bad-arg (str "for lock must be :nowait or :skip-locked, got: " (show lock)))))]
    [(if lock-sql (str "FOR " mode-sql " " lock-sql) (str "FOR " mode-sql)) []]))
