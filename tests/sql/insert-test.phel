(ns phel-sql-tests.sql.insert-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is]))

(deftest test-insert-vector-rows
  (is (= ["INSERT INTO users VALUES (?, ?), (?, ?)" ["a" 1 "b" 2]]
         (sql/format {:insert-into :users :values [["a" 1] ["b" 2]]}))))

(deftest test-insert-vector-rows-with-columns
  (is (= ["INSERT INTO users (name, age) VALUES (?, ?), (?, ?)" ["a" 1 "b" 2]]
         (sql/format {:insert-into :users :columns [:name :age]
                      :values [["a" 1] ["b" 2]]}))))

(deftest test-insert-map-rows
  (is (= ["INSERT INTO users (age, name) VALUES (?, ?), (?, ?)" [1 "a" 2 "b"]]
         (sql/format {:insert-into :users
                      :values [{:name "a" :age 1} {:name "b" :age 2}]}))))

(deftest test-insert-map-rows-union-of-keys
  (is (= ["INSERT INTO users (age, email, name) VALUES (?, ?, ?), (?, ?, ?)"
          [1 nil "a" nil "b@x" "b"]]
         (sql/format {:insert-into :users
                      :values [{:name "a" :age 1} {:name "b" :email "b@x"}]}))))

(deftest test-insert-with-returning
  (is (= ["INSERT INTO users (name) VALUES (?) RETURNING id" ["a"]]
         (sql/format {:insert-into :users :values [{:name "a"}] :returning [:id]}))))

(deftest test-insert-with-cte
  (is (= ["WITH defaults AS (SELECT 1) INSERT INTO users VALUES (?)" ["a"]]
         (sql/format {:with [[:defaults {:select ["1"]}]]
                      :insert-into :users :values [["a"]]}))))

(deftest test-insert-rejects-missing-values
  (is (thrown? \InvalidArgumentException (sql/format {:insert-into :users}))))

(deftest test-insert-rejects-mixed-rows
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :users :values [{:name "a"} ["b"]]}))))

(deftest test-insert-map-rows-follow-explicit-columns-order
  (is (= ["INSERT INTO t (b, a) VALUES (?, ?)" [2 1]]
         (sql/format {:insert-into :t :columns [:b :a] :values [{:a 1 :b 2}]}))))

(deftest test-insert-map-rows-explicit-columns-missing-key-is-nil
  (is (= ["INSERT INTO t (a, b) VALUES (?, ?)" [1 nil]]
         (sql/format {:insert-into :t :columns [:a :b] :values [{:a 1}]}))))

(deftest test-insert-map-rows-reject-key-outside-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [:a] :values [{:a 1 :c 3}]}))))

(deftest test-insert-map-rows-with-different-key-counts
  (is (= ["INSERT INTO t (a, b, c) VALUES (?, ?, ?), (?, ?, ?)" [1 nil nil nil 2 3]]
         (sql/format {:insert-into :t :values [{:a 1} {:b 2 :c 3}]}))))

(deftest test-insert-string-columns-with-map-rows
  (is (= ["INSERT INTO t (b, a) VALUES (?, ?)" [2 1]]
         (sql/format {:insert-into :t :columns ["b" "a"] :values [{:a 1 :b 2}]}))))

(deftest test-insert-map-row-false-value-is-kept
  (is (= ["INSERT INTO t (a) VALUES (?)" [false]]
         (sql/format {:insert-into :t :columns [:a] :values [{:a false}]}))))

(deftest test-insert-map-rows-spelling-a-column-differently-per-row
  (is (= ["INSERT INTO t (a) VALUES (?), (?)" [1 2]]
         (sql/format {:insert-into :t :columns [:a] :values [{:a 1} {"a" 2}]}))))

(deftest test-insert-map-rows-namespaced-and-dotted-keys-match-one-column
  (is (= ["INSERT INTO t (b.x) VALUES (?), (?)" [1 2]]
         (sql/format {:insert-into :t :columns [:b.x] :values [{:b/x 1} {:b.x 2}]}))))

;; ---- INSERT ... SELECT ----

(deftest test-insert-select-query
  (is (= ["INSERT INTO archive SELECT id, name FROM users WHERE created_at < ?" ["2020-01-01"]]
         (sql/format {:insert-into :archive
                      :query {:select [:id :name] :from [:users]
                              :where [:< :created_at "2020-01-01"]}}))))

(deftest test-insert-select-query-with-columns
  (is (= ["INSERT INTO archive (id, name) SELECT id, name FROM users WHERE created_at < ?" ["2020-01-01"]]
         (sql/format {:insert-into :archive :columns [:id :name]
                      :query {:select [:id :name] :from [:users]
                              :where [:< :created_at "2020-01-01"]}}))))

(deftest test-insert-select-set-op-query
  (is (= ["INSERT INTO t (id) (SELECT id FROM a WHERE x = ?) UNION (SELECT id FROM b WHERE y = ?)" [1 2]]
         (sql/format {:insert-into :t :columns [:id]
                      :query {:union [{:select [:id] :from [:a] :where [:= :x 1]}
                                      {:select [:id] :from [:b] :where [:= :y 2]}]}}))))

(deftest test-insert-select-values-query
  (is (= ["INSERT INTO t (a, b) VALUES (?, ?), (?, ?)" [1 2 3 4]]
         (sql/format {:insert-into :t :columns [:a :b]
                      :query {:values [[1 2] [3 4]]}}))))

(deftest test-insert-select-with-cte
  (is (= ["WITH recent AS (SELECT id FROM users WHERE age > ?) INSERT INTO archive (id) SELECT id FROM recent WHERE id < ?" [18 100]]
         (sql/format {:with [[:recent {:select [:id] :from [:users] :where [:> :age 18]}]]
                      :insert-into :archive :columns [:id]
                      :query {:select [:id] :from [:recent] :where [:< :id 100]}}))))

(deftest test-insert-select-returning
  (is (= ["INSERT INTO archive (id) SELECT id FROM users WHERE age > ? RETURNING id" [18]]
         (sql/format {:insert-into :archive :columns [:id]
                      :query {:select [:id] :from [:users] :where [:> :age 18]}
                      :returning [:id]}))))
