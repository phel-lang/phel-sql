(ns phel-sql-tests.sql.group-by-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is]))

(deftest test-group-by
  (is (= ["SELECT country FROM users GROUP BY country" []]
         (sql/format {:select [:country] :from [:users] :group-by [:country]}))))

(deftest test-having
  (is (= ["SELECT country FROM users GROUP BY country HAVING COUNT(*) > ?" [10]]
         (sql/format {:select [:country] :from [:users]
                      :group-by [:country]
                      :having [:> [:raw "COUNT(*)"] 10]}))))

(deftest test-group-by-having-complex
  (is (= ["SELECT dept FROM emp GROUP BY dept HAVING (SUM(salary) > ?) AND (COUNT(*) >= ?)"
          [100000 5]]
         (sql/format {:select [:dept] :from [:emp]
                      :group-by [:dept]
                      :having [:and [:> [:raw "SUM(salary)"] 100000]
                               [:>= [:raw "COUNT(*)"] 5]]}))))

(deftest test-group-by-rollup
  (is (= ["SELECT region, city FROM sales GROUP BY ROLLUP (region, city)" []]
         (sql/format {:select [:region :city] :from [:sales]
                      :group-by [[:rollup :region :city]]}))))

(deftest test-group-by-cube
  (is (= ["SELECT region, city FROM sales GROUP BY CUBE (region, city)" []]
         (sql/format {:select [:region :city] :from [:sales]
                      :group-by [[:cube :region :city]]}))))

(deftest test-group-by-grouping-sets
  (is (= ["SELECT region, city FROM sales GROUP BY GROUPING SETS ((region, city), (region))" []]
         (sql/format {:select [:region :city] :from [:sales]
                      :group-by [[:grouping-sets [:region :city] [:region]]]}))))

(deftest test-group-by-grouping-sets-empty-set
  (is (= ["SELECT region FROM sales GROUP BY GROUPING SETS ((region), ())" []]
         (sql/format {:select [:region] :from [:sales]
                      :group-by [[:grouping-sets [:region] []]]}))))

(deftest test-group-by-plain-column-then-rollup
  (is (= ["SELECT country FROM sales GROUP BY country, ROLLUP (region, city)" []]
         (sql/format {:select [:country] :from [:sales]
                      :group-by [:country [:rollup :region :city]]}))))

(deftest test-group-by-rollup-then-plain-column
  (is (= ["SELECT country FROM sales GROUP BY ROLLUP (region), country" []]
         (sql/format {:select [:country] :from [:sales]
                      :group-by [[:rollup :region] :country]}))))

(deftest test-group-by-rollup-binds-params-in-order
  (is (= ["SELECT a FROM t GROUP BY ROLLUP (nullif(a, ?), b)" ["x"]]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:rollup [:fn :nullif :a "x"] :b]]}))))

(deftest test-group-by-grouping-sets-binds-params-in-order
  (is (= ["SELECT a FROM t GROUP BY GROUPING SETS ((nullif(a, ?)), (coalesce(b, ?)))" ["x" "y"]]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:grouping-sets [[:fn :nullif :a "x"]] [[:fn :coalesce :b "y"]]]]}))))

(deftest test-group-by-rollup-with-having
  (is (= ["SELECT region FROM t GROUP BY ROLLUP (region) HAVING COUNT(*) > ?" [1]]
         (sql/format {:select [:region] :from [:t]
                      :group-by [[:rollup :region]]
                      :having [:> [:raw "COUNT(*)"] 1]}))))

(deftest test-group-by-rollup-composite-item
  (is (= ["SELECT a FROM t GROUP BY ROLLUP (a, (b, c))" []]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:rollup :a [:b :c]]]}))))

(deftest test-group-by-cube-composite-item-same-names
  (is (= ["SELECT a FROM t GROUP BY CUBE (a, (b, a))" []]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:cube :a [:b :a]]]}))))

(deftest test-group-by-grouping-sets-nested-rollup
  (is (= ["SELECT a FROM t GROUP BY GROUPING SETS ((a), ROLLUP (a, b))" []]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:grouping-sets [:a] [:rollup :a :b]]]}))))

(deftest test-group-by-grouping-sets-list-set
  (is (= ["SELECT a FROM t GROUP BY GROUPING SETS ((a, b), (a))" []]
         (sql/format {:select [:a] :from [:t]
                      :group-by [[:grouping-sets (list :a :b) (list :a)]]}))))
