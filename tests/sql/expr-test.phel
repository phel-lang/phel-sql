(ns phel-sql-tests.sql.expr-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is]))

;; ---- Function calls ----

(deftest test-fn-no-args
  (is (= ["SELECT now()" []] (sql/format {:select [[:fn :now]]}))))

(deftest test-fn-star
  (is (= ["SELECT count(*) FROM users" []]
         (sql/format {:select [[:fn :count :*]] :from [:users]}))))

(deftest test-fn-with-column
  (is (= ["SELECT sum(amount) FROM orders" []]
         (sql/format {:select [[:fn :sum :amount]] :from [:orders]}))))

(deftest test-fn-with-alias
  (is (= ["SELECT count(*) AS total FROM users" []]
         (sql/format {:select [[[:fn :count :*] :total]] :from [:users]}))))

(deftest test-fn-with-value-arg
  (is (= ["SELECT date_trunc(?, created_at) FROM t" ["month"]]
         (sql/format {:select [[:fn :date_trunc "month" :created_at]] :from [:t]}))))

(deftest test-fn-nested
  (is (= ["SELECT coalesce(name, ?) FROM t" ["unknown"]]
         (sql/format {:select [[:fn :coalesce :name "unknown"]] :from [:t]}))))

(deftest test-fn-in-where
  (is (= ["SELECT id FROM t WHERE lower(name) = ?" ["alice"]]
         (sql/format {:select [:id] :from [:t]
                      :where [:= [:fn :lower :name] "alice"]}))))

(deftest test-fn-rejects-non-name
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:fn 42 :x]]}))))

;; ---- CAST ----

(deftest test-cast-basic
  (is (= ["SELECT CAST(id AS INT) FROM t" []]
         (sql/format {:select [[:cast :id :INT]] :from [:t]}))))

(deftest test-cast-string-type
  (is (= ["SELECT CAST(price AS DECIMAL(10,2)) FROM t" []]
         (sql/format {:select [[:cast :price "DECIMAL(10,2)"]] :from [:t]}))))

(deftest test-cast-with-value
  (is (= ["UPDATE t SET v = CAST(? AS INT)" ["7"]]
         (sql/format {:update :t :set {:v [:cast "7" :INT]}}))))

(deftest test-cast-rejects-missing-type
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:cast :id nil]]}))))

(deftest test-cast-rejects-bad-type
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:cast :id 42]]}))))

;; ---- CASE ----

(deftest test-case-simple
  (is (= ["SELECT CASE WHEN status = ? THEN ? WHEN status = ? THEN ? END FROM t"
          ["a" "Active" "b" "Banned"]]
         (sql/format {:select [[:case
                                [:= :status "a"] "Active"
                                [:= :status "b"] "Banned"]]
                      :from [:t]}))))

(deftest test-case-with-else
  (is (= ["SELECT CASE WHEN status = ? THEN ? ELSE ? END FROM t" ["a" "Active" "Unknown"]]
         (sql/format {:select [[:case [:= :status "a"] "Active" :else "Unknown"]]
                      :from [:t]}))))

(deftest test-case-then-keyword-is-identifier
  (is (= ["SELECT CASE WHEN status = ? THEN active_name ELSE inactive_name END FROM t" ["a"]]
         (sql/format {:select [[:case [:= :status "a"] :active_name :else :inactive_name]]
                      :from [:t]}))))

(deftest test-case-with-alias
  (is (= ["SELECT CASE WHEN n > ? THEN ? ELSE ? END AS label FROM t" [0 "pos" "neg"]]
         (sql/format {:select [[[:case [:> :n 0] "pos" :else "neg"] :label]] :from [:t]}))))

(deftest test-case-rejects-empty
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:case]]}))))

(deftest test-case-rejects-odd-pairs
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:case [:= :a 1] "x" [:= :b 2]]]}))))

(deftest test-case-rejects-misplaced-else
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:case :else "x" [:= :a 1] "y"]]}))))

;; ---- FILTER ----

(deftest test-filter
  (is (= ["SELECT count(*) FILTER (WHERE status = ?) AS active FROM users" ["active"]]
         (sql/format {:select [[[:filter [:fn :count :*] [:= :status "active"]] :active]]
                      :from [:users]}))))

(deftest test-filter-with-over
  (is (= [(str "SELECT sum(amount) FILTER (WHERE refunded = ?) "
               "OVER (PARTITION BY user_id) FROM orders")
          [false]]
         (sql/format
          {:select [[:over [:filter [:fn :sum :amount] [:= :refunded false]]
                     {:partition-by [:user_id]}]]
           :from [:orders]}))))

;; ---- Operators ----

(deftest test-operator-add-columns
  (is (= ["SELECT price + tax AS total FROM t" []]
         (sql/format {:select [[[:+ :price :tax] :total]] :from [:t]}))))

(deftest test-operator-subtract
  (is (= ["SELECT a - b FROM t" []] (sql/format {:select [[:- :a :b]] :from [:t]}))))

(deftest test-operator-multiply
  (is (= ["SELECT a * b FROM t" []] (sql/format {:select [[:* :a :b]] :from [:t]}))))

(deftest test-operator-divide
  (is (= ["SELECT a / b FROM t" []] (sql/format {:select [[:div :a :b]] :from [:t]}))))

(deftest test-operator-modulo
  (is (= ["SELECT a % b FROM t" []] (sql/format {:select [[:% :a :b]] :from [:t]}))))

(deftest test-operator-concat
  (is (= ["SELECT first || ? || last FROM t" [" "]]
         (sql/format {:select [[:|| :first " " :last]] :from [:t]}))))

(deftest test-operator-variadic
  (is (= ["SELECT a + b + c + ? FROM t" [1]]
         (sql/format {:select [[:+ :a :b :c 1]] :from [:t]}))))

(deftest test-operator-nested-is-wrapped
  (is (= ["SELECT (a + b) * c FROM t" []]
         (sql/format {:select [[:* [:+ :a :b] :c]] :from [:t]}))))

(deftest test-operator-nested-on-the-right
  (is (= ["SELECT a - (b - c) FROM t" []]
         (sql/format {:select [[:- :a [:- :b :c]]] :from [:t]}))))

(deftest test-operator-params-left-to-right
  (is (= ["SELECT ((a + ?) * ?) - ? FROM t" [1 2 3]]
         (sql/format {:select [[:- [:* [:+ :a 1] 2] 3]] :from [:t]}))))

(deftest test-operator-with-function-operand-not-wrapped
  (is (= ["SELECT sum(a) + ? FROM t" [1]]
         (sql/format {:select [[:+ [:fn :sum :a] 1]] :from [:t]}))))

(deftest test-operator-inside-fn
  (is (= ["SELECT round(a * ?) FROM t" [2]]
         (sql/format {:select [[:fn :round [:* :a 2]]] :from [:t]}))))

(deftest test-operator-inside-cast
  (is (= ["SELECT CAST(a + b AS int) FROM t" []]
         (sql/format {:select [[:cast [:+ :a :b] :int]] :from [:t]}))))

(deftest test-operator-inside-case
  (is (= ["SELECT CASE WHEN a > ? THEN a - ? ELSE ? END FROM t" [0 1 0]]
         (sql/format {:select [[:case [:> :a 0] [:- :a 1] :else 0]] :from [:t]}))))

(deftest test-operator-in-where
  (is (= ["SELECT * FROM t WHERE price + tax > ?" [100]]
         (sql/format {:select [:*] :from [:t] :where [:> [:+ :price :tax] 100]}))))

(deftest test-operator-in-order-by
  (is (= ["SELECT * FROM t ORDER BY a - b DESC" []]
         (sql/format {:select [:*] :from [:t] :order-by [[[:- :a :b] :desc]]}))))

(deftest test-operator-in-group-by
  (is (= ["SELECT a % ? FROM t GROUP BY a % ?" [2 3]]
         (sql/format {:select [[:% :a 2]] :from [:t] :group-by [[:% :a 3]]}))))

(deftest test-operator-in-update-set
  (is (= ["UPDATE t SET n = n + ? WHERE id = ?" [1 7]]
         (sql/format {:update :t :set {:n [:+ :n 1]} :where [:= :id 7]}))))

;; ---- JSON operators ----

(deftest test-json-text-arrow-with-alias
  (is (= ["SELECT price + tax AS total, data ->> ? AS n FROM t" ["name"]]
         (sql/format {:select [[[:+ :price :tax] :total] [[:->> :data "name"] :n]] :from [:t]}))))

(deftest test-json-arrow
  (is (= ["SELECT data -> ? FROM t" ["a"]] (sql/format {:select [[:-> :data "a"]] :from [:t]}))))

(deftest test-json-path
  (is (= ["SELECT data #> ? FROM t" ["{a,b}"]] (sql/format {:select [[:json-path :data "{a,b}"]] :from [:t]}))))

(deftest test-json-path-text
  (is (= ["SELECT data #>> ? FROM t" ["{a,b}"]] (sql/format {:select [[:json-path-text :data "{a,b}"]] :from [:t]}))))

(deftest test-json-contains
  (is (= ["SELECT data @> ? FROM t" ["[1]"]] (sql/format {:select [[:json-contains :data "[1]"]] :from [:t]}))))

(deftest test-json-contained-by
  (is (= ["SELECT data <@ ? FROM t" ["{}"]] (sql/format {:select [[:json-contained-by :data "{}"]] :from [:t]}))))

(deftest test-json-in-where
  (is (= ["SELECT * FROM t WHERE data ->> ? = ?" ["name" "x"]]
         (sql/format {:select [:*] :from [:t] :where [:= [:->> :data "name"] "x"]}))))

(deftest test-json-chained-is-wrapped
  (is (= ["SELECT (data -> ?) ->> ? FROM t" ["a" "b"]]
         (sql/format {:select [[:->> [:-> :data "a"] "b"]] :from [:t]}))))

(deftest test-json-inside-concat
  (is (= ["SELECT (data ->> ?) || ? FROM t" ["a" "!"]]
         (sql/format {:select [[:|| [:->> :data "a"] "!"]] :from [:t]}))))

(deftest test-json-contains-as-where-condition
  (is (= ["SELECT * FROM t WHERE doc @> CAST(? AS jsonb)" ["{}"]]
         (sql/format {:select [:*] :from [:t] :where [:json-contains :doc [:cast "{}" :jsonb]]}))))

(deftest test-json-contained-by-as-where-condition
  (is (= ["SELECT * FROM t WHERE doc <@ ?" ["{}"]]
         (sql/format {:select [:*] :from [:t] :where [:json-contained-by :doc "{}"]}))))

(deftest test-json-contains-inside-and-and-having
  (is (= ["SELECT a FROM t GROUP BY a HAVING (doc @> ?) AND (n > ?)" ["{}" 1]]
         (sql/format {:select [:a] :from [:t] :group-by [:a]
                      :having [:and [:json-contains :doc "{}"] [:> :n 1]]}))))
