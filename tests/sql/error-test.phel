(ns phel-sql-tests.sql.error-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is]))

(deftest test-rejects-non-map-input
  (is (thrown? \InvalidArgumentException (sql/format [:select [:id]]))))

(deftest test-rejects-unknown-clause
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :wat [:dept]}))))

(deftest test-rejects-unsupported-identifier
  (is (thrown? \InvalidArgumentException (sql/format {:select [42]}))))

(deftest test-rejects-select-clauses-in-update
  (is (thrown? \InvalidArgumentException
               (sql/format {:update :t :set {:a 1} :group-by [:b]}))))

(deftest test-rejects-select-clauses-in-delete
  (is (thrown? \InvalidArgumentException
               (sql/format {:delete-from :t :group-by [:b]}))))

(deftest test-rejects-map-row-key-outside-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [:a] :values [{:a 1 :c 3}]}))))

(deftest test-rejects-insert-row-width-differs-from-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [:a :b] :values [[1]]}))))

(deftest test-rejects-insert-ragged-vector-rows
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1 2] [3]]}))))

(deftest test-rejects-insert-empty-vector-row
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[]]}))))

(deftest test-rejects-insert-empty-map-row
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [{}]}))))

(deftest test-rejects-on-conflict-where-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :on-conflict-where [:= :a 1]}))))

(deftest test-rejects-do-nothing-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :do-nothing true}))))

(deftest test-rejects-do-update-set-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :do-update-set {:a 1}}))))

(deftest test-rejects-do-update-where-without-do-update-set
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :on-conflict [:id]
                            :do-nothing true :do-update-where [:= :a 1]}))))

(deftest test-rejects-binary-op-with-one-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a]}))))

(deftest test-rejects-binary-op-with-three-args
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a 1 2]}))))

(deftest test-rejects-in-with-one-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:in :a]}))))

(deftest test-rejects-between-with-two-args
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:between :a 1]}))))

(deftest test-rejects-is-null-without-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:is-null]}))))

(deftest test-rejects-not-with-two-clauses
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:not [:= :a 1] [:= :b 2]]}))))

(deftest test-rejects-exists-with-two-subqueries
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t]
                            :where [:exists {:select [:1]} {:select [:2]}]}))))

(deftest test-rejects-empty-select
  (is (thrown? \InvalidArgumentException (sql/format {:select [] :from [:t]}))))

(deftest test-rejects-nil-select
  (is (thrown? \InvalidArgumentException (sql/format {:select nil :from [:t]}))))

(deftest test-rejects-keyword-select
  (is (thrown? \InvalidArgumentException (sql/format {:select :id :from [:t]}))))

(deftest test-rejects-empty-from
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from []}))))

(deftest test-rejects-empty-group-by
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from [:t] :group-by []}))))

(deftest test-rejects-empty-order-by
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from [:t] :order-by []}))))

(deftest test-rejects-empty-returning
  (is (thrown? \InvalidArgumentException
               (sql/format {:delete-from :t :returning []}))))

(deftest test-rejects-empty-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [] :values [[1]]}))))

(deftest test-rejects-keyword-partition-by
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :sum :x] {:partition-by :a}]] :from [:t]}))))

(deftest test-error-message-names-the-clause
  (let [msg (try (sql/format {:select [:id] :from [:t] :group-by []})
                 (catch \InvalidArgumentException e (.getMessage e)))]
    (is (php/str_contains msg ":group-by"))))

(deftest test-rejects-update-without-set
  (is (thrown? \InvalidArgumentException (sql/format {:update :t :where [:= :id 1]}))))

(deftest test-rejects-bare-update
  (is (thrown? \InvalidArgumentException (sql/format {:update :t}))))

(deftest test-rejects-plain-vector-operand
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a [1 2]]}))))

(deftest test-rejects-unknown-tag-operand
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a [:foo 1]]}))))

(deftest test-rejects-nested-vector-in-list
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:in :a [[1 2]]]}))))
