(ns phel-sql-tests.sql.error-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is]))

(deftest test-rejects-non-map-input
  (is (thrown? \InvalidArgumentException (sql/format [:select [:id]]))))

(deftest test-rejects-unknown-clause
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :wat [:dept]}))))

(deftest test-rejects-unsupported-identifier
  (is (thrown? \InvalidArgumentException (sql/format {:select [42]}))))

(deftest test-rejects-select-clauses-in-update
  (is (thrown? \InvalidArgumentException
               (sql/format {:update :t :set {:a 1} :group-by [:b]}))))

(deftest test-rejects-select-clauses-in-delete
  (is (thrown? \InvalidArgumentException
               (sql/format {:delete-from :t :group-by [:b]}))))

(deftest test-rejects-map-row-key-outside-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [:a] :values [{:a 1 :c 3}]}))))

(deftest test-rejects-insert-row-width-differs-from-columns
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :columns [:a :b] :values [[1]]}))))

(deftest test-rejects-insert-ragged-vector-rows
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1 2] [3]]}))))

(deftest test-rejects-insert-empty-vector-row
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[]]}))))

(deftest test-rejects-insert-empty-map-row
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [{}]}))))

(deftest test-rejects-on-conflict-where-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :on-conflict-where [:= :a 1]}))))

(deftest test-rejects-do-nothing-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :do-nothing true}))))

(deftest test-rejects-do-update-set-without-on-conflict
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :do-update-set {:a 1}}))))

(deftest test-rejects-do-update-where-without-do-update-set
  (is (thrown? \InvalidArgumentException
               (sql/format {:insert-into :t :values [[1]] :on-conflict [:id]
                            :do-nothing true :do-update-where [:= :a 1]}))))

(deftest test-rejects-binary-op-with-one-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a]}))))

(deftest test-rejects-binary-op-with-three-args
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a 1 2]}))))

(deftest test-rejects-in-with-one-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:in :a]}))))

(deftest test-rejects-between-with-two-args
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:between :a 1]}))))

(deftest test-rejects-is-null-without-arg
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:is-null]}))))

(deftest test-rejects-not-with-two-clauses
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:not [:= :a 1] [:= :b 2]]}))))

(deftest test-rejects-exists-with-two-subqueries
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t]
                            :where [:exists {:select [:1]} {:select [:2]}]}))))

(deftest test-rejects-empty-select
  (is (thrown? \InvalidArgumentException (sql/format {:select [] :from [:t]}))))

(deftest test-rejects-nil-select
  (is (thrown? \InvalidArgumentException (sql/format {:select nil :from [:t]}))))

(deftest test-rejects-keyword-select
  (is (thrown? \InvalidArgumentException (sql/format {:select :id :from [:t]}))))

(deftest test-rejects-empty-from
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from []}))))

(deftest test-rejects-empty-group-by
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from [:t] :group-by []}))))

(deftest test-rejects-empty-order-by
  (is (thrown? \InvalidArgumentException (sql/format {:select [:id] :from [:t] :order-by []}))))

(deftest test-rejects-empty-returning
  (is (thrown? \InvalidArgumentException
               (sql/format {:delete-from :t :returning []}))))

(deftest test-rejects-empty-columns
  (is (thrown-with-msg? \InvalidArgumentException ":columns expects a non-empty vector or list, got: []"
                        (sql/format {:insert-into :t :columns [] :values [[1]]}))))

(deftest test-rejects-keyword-partition-by
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :sum :x] {:partition-by :a}]] :from [:t]}))))

(deftest test-error-message-names-the-clause
  (is (thrown-with-msg? \InvalidArgumentException ":group-by expects a non-empty vector or list, got: []"
                        (sql/format {:select [:id] :from [:t] :group-by []}))))

(deftest test-rejects-update-without-set
  (is (thrown? \InvalidArgumentException (sql/format {:update :t :where [:= :id 1]}))))

(deftest test-rejects-bare-update
  (is (thrown? \InvalidArgumentException (sql/format {:update :t}))))

(deftest test-rejects-plain-vector-operand
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a [1 2]]}))))

(deftest test-rejects-unknown-tag-operand
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= :a [:foo 1]]}))))

(deftest test-rejects-nested-vector-in-list
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:in :a [[1 2]]]}))))

(deftest test-error-message-shows-keyword-as-phel-literal
  (is (thrown-with-msg? \InvalidArgumentException "Unknown where operator: :bogus"
                        (sql/format {:select [:id] :from [:t] :where [:bogus :a 1]}))))

(deftest test-error-message-shows-map-on-one-line
  (is (thrown-with-msg? \InvalidArgumentException "Unsupported order-by item: {:a 1}"
                        (sql/format {:select [:id] :from [:t] :order-by [{:a 1}]}))))

(deftest test-rejects-raw-without-sql
  (is (thrown? \InvalidArgumentException (sql/format {:select [[:raw]] :from [:t]}))))

(deftest test-rejects-raw-with-non-string
  (is (thrown? \InvalidArgumentException (sql/format {:select [[:raw 42]] :from [:t]}))))

(deftest test-rejects-raw-with-extra-args
  (is (thrown? \InvalidArgumentException (sql/format {:select [[:raw "a" "b"]] :from [:t]}))))

(deftest test-rejects-alias-with-extra-elements
  (is (thrown? \InvalidArgumentException (sql/format {:select [[:id :a :b]] :from [:t]}))))

(deftest test-rejects-for-with-extra-elements
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :for [:update :nowait :extra]}))))

(deftest test-rejects-raw-with-order-direction
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :order-by [[:raw "x" :desc]]}))))

(deftest test-rejects-negative-frame-offset
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :sum :x] {:frame [:rows [:preceding -1]]}]]
                            :from [:t]}))))

(deftest test-rejects-keyword-identifier-with-statement-break
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [(keyword "id; DROP TABLE t --")] :from [:t]}))))

(deftest test-rejects-keyword-identifier-with-space
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [(keyword "a b")] :from [:t]}))))

(deftest test-rejects-keyword-identifier-with-paren
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :where [:= (keyword "a)") 1]}))))

(deftest test-rejects-keyword-namespace-with-injection
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [(keyword "t; --" "id")] :from [:t]}))))

(deftest test-rejects-keyword-identifier-with-newline
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [(keyword "a\n")] :from [:t]}))))

(deftest test-rejects-where-on-set-op
  (is (thrown-with-msg? \InvalidArgumentException "set-op query supports only one of union/union-all/intersect/except plus the wrapper keys with, with-recursive, order-by, limit, offset, got extras: where"
                        (sql/format {:union [{:select [:id] :from [:a]}
                                             {:select [:id] :from [:b]}]
                                     :where [:= :x 1]}))))

(deftest test-rejects-two-set-op-keys
  (is (thrown? \InvalidArgumentException
               (sql/format {:union     [{:select [:id] :from [:a]}
                                        {:select [:id] :from [:b]}]
                            :union-all [{:select [:id] :from [:c]}
                                        {:select [:id] :from [:d]}]}))))

(deftest test-rejects-negative-set-op-limit
  (is (thrown-with-msg? \InvalidArgumentException "limit must be a non-negative integer, got: -1"
                        (sql/format {:union [{:select [:id] :from [:a]}
                                             {:select [:id] :from [:b]}]
                                     :limit -1}))))

(deftest test-rejects-bad-set-op-with-shape
  (is (thrown-with-msg? \InvalidArgumentException "WITH binding must be [name query], got: :oops"
                        (sql/format {:union [{:select [:id] :from [:a]}
                                             {:select [:id] :from [:b]}]
                                     :with  [:oops]}))))

(deftest test-rejects-with-and-with-recursive-on-set-op
  (is (thrown-with-msg? \InvalidArgumentException "set-op query accepts only one of with/with-recursive"
                        (sql/format {:union          [{:select [:id] :from [:a]}
                                                      {:select [:id] :from [:b]}]
                                     :with           [[:c {:select [:id] :from [:t]}]]
                                     :with-recursive [[:d {:select [:id] :from [:t]}]]}))))

(deftest test-values-still-rejects-limit
  (is (thrown? \InvalidArgumentException (sql/format {:values [[1 2]] :limit 1}))))

(deftest test-rejects-insert-with-values-and-query
  (is (thrown-with-msg? \InvalidArgumentException ":values and :query are mutually exclusive, got both: [[1]] and {:select [:a]}"
                        (sql/format {:insert-into :t :values [[1]] :query {:select [:a]}}))))

(deftest test-rejects-insert-without-values-or-query
  (is (thrown-with-msg? \InvalidArgumentException "insert statement requires :values or :query"
                        (sql/format {:insert-into :t :columns [:a]}))))

(deftest test-rejects-insert-query-not-a-map
  (is (thrown-with-msg? \InvalidArgumentException ":query expects a map, got: [:select :a]"
                        (sql/format {:insert-into :t :query [:select :a]}))))

(deftest test-rejects-insert-query-that-is-an-insert
  (is (thrown-with-msg? \InvalidArgumentException ":query expects a SELECT, VALUES or set operation, got: {:insert-into :u, :values [[1]]}"
                        (sql/format {:insert-into :t :query {:insert-into :u :values [[1]]}}))))

(deftest test-rejects-insert-query-without-select
  (is (thrown-with-msg? \InvalidArgumentException ":query expects a SELECT, VALUES or set operation, got: {:from [:u]}"
                        (sql/format {:insert-into :t :query {:from [:u]}}))))

(deftest test-rejects-insert-query-empty-map
  (is (thrown-with-msg? \InvalidArgumentException ":query expects a SELECT, VALUES or set operation, got: {}"
                        (sql/format {:insert-into :t :query {}}))))

(deftest test-rejects-insert-query-values-with-map-rows
  (is (thrown-with-msg? \InvalidArgumentException ":query VALUES rows must be vectors (use :columns to name them), got: {:values [{:a 1}]}"
                        (sql/format {:insert-into :t :query {:values [{:a 1}]}}))))

(deftest test-rejects-empty-window
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window []}))))

(deftest test-rejects-window-not-pairs
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window [:w]}))))

(deftest test-rejects-window-pair-wrong-size
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window [[:w {} {}]]}))))

(deftest test-rejects-window-name-not-keyword-or-string
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window [[1 {}]]}))))

(deftest test-rejects-window-spec-not-a-map
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window [[:w [:dept]]]}))))

(deftest test-rejects-window-invalid-name
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:id] :from [:t] :window [[:w-- {}]]}))))

(deftest test-rejects-over-bad-window-name
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :rank] 42]] :from [:t]}))))

(deftest test-rejects-over-vector-second-argument
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :rank] [:w]]] :from [:t]}))))

(deftest test-rejects-window-spec-bad-extended-name
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:over [:fn :rank] {:window 42}]] :from [:t]}))))

(deftest test-window-entry-reports-bad-name-first
  (is (thrown-with-msg? \InvalidArgumentException "window name must be a keyword or string, got: 1"
                        (sql/format {:select [:id] :from [:t] :window [[1 :x]]}))))

(deftest test-window-entry-reports-bad-spec
  (is (thrown-with-msg? \InvalidArgumentException ":window expects a window-spec map, got: :x"
                        (sql/format {:select [:id] :from [:t] :window [[:w :x]]}))))

(deftest test-rejects-over-extra-argument
  (is (thrown-with-msg? \InvalidArgumentException "over expects [:over expr window], got: [:over [:fn :rank] :w :x]"
                        (sql/format {:select [[:over [:fn :rank] :w :x]] :from [:t]}))))

(deftest test-rejects-over-missing-window
  (is (thrown-with-msg? \InvalidArgumentException "over expects [:over expr window], got: [:over [:fn :rank]]"
                        (sql/format {:select [[:over [:fn :rank]]] :from [:t]}))))
(deftest test-rejects-empty-rollup
  (is (thrown-with-msg? \InvalidArgumentException ":rollup expects at least one column, got: [:rollup]"
                        (sql/format {:select [:a] :from [:t] :group-by [[:rollup]]}))))

(deftest test-rejects-empty-cube
  (is (thrown-with-msg? \InvalidArgumentException ":cube expects at least one column, got: [:cube]"
                        (sql/format {:select [:a] :from [:t] :group-by [[:cube]]}))))

(deftest test-rejects-empty-grouping-sets
  (is (thrown-with-msg? \InvalidArgumentException ":grouping-sets expects at least one set, got: [:grouping-sets]"
                        (sql/format {:select [:a] :from [:t] :group-by [[:grouping-sets]]}))))

(deftest test-rejects-non-vector-grouping-set
  (is (thrown-with-msg? \InvalidArgumentException ":grouping-sets expects each set to be a vector, got: :a"
                        (sql/format {:select [:a] :from [:t] :group-by [[:grouping-sets :a]]}))))

(deftest test-rejects-nested-rollup
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:a] :from [:t] :group-by [[:rollup [:cube :a :b]]]}))))

(deftest test-rejects-rollup-in-select
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [[:rollup :a]] :from [:t]}))))

(deftest test-rejects-cube-in-where
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:a] :from [:t] :where [:= [:cube :a :b] 1]}))))

(deftest test-rejects-grouping-sets-in-order-by
  (is (thrown? \InvalidArgumentException
               (sql/format {:select [:a] :from [:t] :order-by [[:grouping-sets [:a]]]}))))
