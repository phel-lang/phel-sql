(ns phel-sql-tests.e2e-test
  (:require phel.sql :as sql)
  (:require phel.test :refer [deftest is testing]))

;; ===========================================================================
;; End-to-end scenarios.
;;
;; The per-domain tests under tests/sql/ each focus on one clause or
;; expression form. This file does the opposite: each deftest is a
;; realistic, application-shaped query that exercises many subsystems
;; together. If the per-domain suite passes but one of these fails, a
;; cross-cutting regression has slipped in.
;; ===========================================================================

(deftest e2e-user-dashboard-page
  (testing "paginated dashboard: CTE + alias + join + filter + order + limit"
           (is (= [(str "WITH recent_orders AS (SELECT user_id, count(*) AS n FROM orders "
                        "WHERE created_at >= ? GROUP BY user_id) "
                        "SELECT u.id, u.name, r.n "
                        "FROM users AS u "
                        "JOIN recent_orders AS r ON u.id = r.user_id "
                        "WHERE u.status = ? "
                        "ORDER BY r.n DESC "
                        "LIMIT 25 OFFSET 50")
                   ["2026-01-01" "active"]]
                  (sql/format
                   {:with [[:recent_orders
                            {:select [:user_id [[:fn :count :*] :n]]
                             :from [:orders]
                             :where [:>= :created_at "2026-01-01"]
                             :group-by [:user_id]}]]
                    :select   [:u/id :u/name :r/n]
                    :from     [[:users :u]]
                    :join     [[:recent_orders :r] [:= :u/id :r/user_id]]
                    :where    [:= :u/status "active"]
                    :order-by [[:r/n :desc]]
                    :limit    25
                    :offset   50})))))

(deftest e2e-analytics-rollup
  (testing "aggregation: group + having + filter aggregate + window for ranking"
           (is (= [(str "SELECT country, "
                        "count(*) FILTER (WHERE active = ?) AS active_users, "
                        "row_number() OVER (ORDER BY count(*) DESC) AS rk "
                        "FROM users "
                        "GROUP BY country "
                        "HAVING count(*) >= ?")
                   [true 100]]
                  (sql/format
                   {:select [:country
                             [[:filter [:fn :count :*] [:= :active true]] :active_users]
                             [[:over [:fn :row_number] {:order-by [[[:fn :count :*] :desc]]}] :rk]]
                    :from [:users]
                    :group-by [:country]
                    :having [:>= [:fn :count :*] 100]})))))

(deftest e2e-postgres-upsert
  (testing "PG upsert with EXCLUDED-style update + returning"
           (is (= [(str "INSERT INTO users (email, name) VALUES (?, ?) "
                        "ON CONFLICT (email) DO UPDATE SET name = EXCLUDED.name "
                        "RETURNING id, email")
                   ["a@x.com" "Alice"]]
                  (sql/format
                   {:insert-into :users
                    :values [{:email "a@x.com" :name "Alice"}]
                    :on-conflict [:email]
                    :do-update-set {:name [:raw "EXCLUDED.name"]}
                    :returning [:id :email]})))))

(deftest e2e-mysql-upsert
  (testing "MySQL upsert with VALUES(col) reference"
           (is (= [(str "INSERT INTO counters (key, n) VALUES (?, ?) "
                        "ON DUPLICATE KEY UPDATE n = n + VALUES(n)")
                   ["visits" 1]]
                  (sql/format
                   {:insert-into :counters
                    :values [{:key "visits" :n 1}]
                    :on-duplicate-key-update {:n [:raw "n + VALUES(n)"]}})))))

(deftest e2e-soft-delete-with-exists
  (testing "filter users who do not have a deletion record"
           (is (= [(str "UPDATE users SET status = ?, updated_at = NOW() "
                        "WHERE (id = ?) AND (NOT EXISTS (SELECT 1 FROM deletions "
                        "WHERE user_id = users.id))")
                   ["archived" 42]]
                  (sql/format
                   {:update :users
                    :set {:status "archived"
                          :updated_at [:raw "NOW()"]}
                    :where [:and
                            [:= :id 42]
                            [:not-exists {:select ["1"]
                                          :from [:deletions]
                                          :where [:= :user_id :users/id]}]]})))))

(deftest e2e-bulk-delete-with-returning
  (testing "bulk delete by IN list + RETURNING the removed rows"
           (is (= ["DELETE FROM orders WHERE id IN (?, ?, ?) RETURNING id, user_id"
                   [1 2 3]]
                  (sql/format
                   {:delete-from :orders
                    :where [:in :id [1 2 3]]
                    :returning [:id :user_id]})))))

(deftest e2e-recursive-cte-graph-walk
  (testing "recursive CTE traversing a parent/child tree"
           (is (= [(str "WITH RECURSIVE tree AS ((SELECT id, parent_id FROM nodes WHERE id = ?) "
                        "UNION ALL "
                        "(SELECT n.id, n.parent_id FROM nodes AS n "
                        "JOIN tree AS t ON n.parent_id = t.id)) "
                        "SELECT id FROM tree")
                   [1]]
                  (sql/format
                   {:with-recursive
                    [[:tree
                      {:union-all
                       [{:select [:id :parent_id]
                         :from [:nodes]
                         :where [:= :id 1]}
                        {:select [:n/id :n/parent_id]
                         :from [[:nodes :n]]
                         :join [[:tree :t] [:= :n/parent_id :t/id]]}]}]]
                    :select [:id]
                    :from [:tree]})))))

(deftest e2e-distinct-on-latest-per-group
  (testing "Postgres DISTINCT ON for the latest row per user"
           (is (= [(str "SELECT DISTINCT ON (user_id) user_id, id, created_at "
                        "FROM events "
                        "ORDER BY user_id ASC, created_at DESC")
                   []]
                  (sql/format
                   {:select-distinct-on {:on [:user_id]
                                         :select [:user_id :id :created_at]}
                    :from [:events]
                    :order-by [[:user_id :asc] [:created_at :desc]]})))))

(deftest e2e-lateral-join-top-n-per-group
  (testing "top-N orders per user via LATERAL subquery"
           (is (= [(str "SELECT u.id, o.id, o.amount "
                        "FROM users AS u "
                        "JOIN LATERAL (SELECT id, amount FROM orders WHERE user_id = u.id "
                        "ORDER BY amount DESC LIMIT 3) AS o ON TRUE")
                   []]
                  (sql/format
                   {:select [:u/id :o/id :o/amount]
                    :from [[:users :u]]
                    :join [[[:lateral {:select [:id :amount]
                                       :from [:orders]
                                       :where [:= :user_id :u/id]
                                       :order-by [[:amount :desc]]
                                       :limit 3}] :o]
                           [:raw "TRUE"]]})))))

(deftest e2e-union-of-filtered-queries
  (testing "union of two filtered queries with their own params"
           (is (= [(str "(SELECT id, 'customer' AS source FROM customers WHERE country = ?) "
                        "UNION ALL "
                        "(SELECT id, 'lead' AS source FROM leads WHERE country = ?)")
                   ["ES" "ES"]]
                  (sql/format
                   {:union-all [{:select [:id [[:raw "'customer'"] :source]]
                                 :from [:customers]
                                 :where [:= :country "ES"]}
                                {:select [:id [[:raw "'lead'"] :source]]
                                 :from [:leads]
                                 :where [:= :country "ES"]}]})))))

(deftest e2e-conditional-projection
  (testing "CASE in select to bucket rows + ordering by bucket"
           (is (= [(str "SELECT id, "
                        "CASE WHEN amount > ? THEN ? WHEN amount > ? THEN ? ELSE ? END AS tier "
                        "FROM orders "
                        "ORDER BY tier ASC")
                   [1000 "gold" 100 "silver" "bronze"]]
                  (sql/format
                   {:select [:id
                             [[:case
                               [:> :amount 1000] "gold"
                               [:> :amount 100]  "silver"
                               :else             "bronze"]
                              :tier]]
                    :from [:orders]
                    :order-by [[:tier :asc]]})))))

(deftest e2e-pure-and-deterministic
  (testing "same input always produces same output"
           (let [q {:select [:id :name :email]
                    :from [:users]
                    :where [:= :status "active"]
                    :order-by [[:created_at :desc]]
                    :limit 10}]
             (is (= (sql/format q) (sql/format q)))
             (is (= (sql/format q) (sql/format q)))))

  (testing "no I/O leaks: params come back as a vector, sql as a string"
           (let [[s p] (sql/format {:select [:id] :from [:t] :where [:= :a 1]})]
             (is (string? s))
             (is (vector? p))
             (is (= [1] p)))))

;; ===========================================================================
;; Cookbook (docs/cookbook.md). Each deftest holds one snippet from the doc.
;; ===========================================================================

(defn- search-users [{:keys [status min-age name]}]
  {:select [:id :name]
   :from   [:users]
   :where  [:and
            (when status [:= :status status])
            (when min-age [:>= :age min-age])
            (when name [:ilike :name (str "%" name "%")])]})

(deftest test-cookbook-filters-all-set
  (is (= ["SELECT id, name FROM users WHERE (status = ?) AND (age >= ?) AND (name ILIKE ?)"
          ["active" 18 "%ann%"]]
         (sql/format (search-users {:status "active" :min-age 18 :name "ann"})))))

(deftest test-cookbook-filters-one-set
  (is (= ["SELECT id, name FROM users WHERE status = ?" ["active"]]
         (sql/format (search-users {:status "active"})))))

(deftest test-cookbook-filters-none-set
  (is (= ["SELECT id, name FROM users" []]
         (sql/format (search-users {})))))

(deftest test-cookbook-pagination
  (is (= ["SELECT id, name FROM users WHERE status = ? ORDER BY created_at DESC, id DESC LIMIT 20 OFFSET 40"
          ["active"]]
         (sql/format
          {:select   [:id :name]
           :from     [:users]
           :where    [:= :status "active"]
           :order-by [[:created_at :desc] [:id :desc]]
           :limit    20
           :offset   40}))))

(deftest test-cookbook-upsert
  (is (= ["INSERT INTO users (email, name) VALUES (?, ?) ON CONFLICT (email) DO UPDATE SET name = ?"
          ["a@x.com" "alice" "alice"]]
         (sql/format
          {:insert-into   :users
           :values        [{:email "a@x.com" :name "alice"}]
           :on-conflict   [:email]
           :do-update-set {:name "alice"}}))))

(deftest test-cookbook-bulk-insert
  (is (= ["INSERT INTO users (email, name) VALUES (?, ?), (?, ?)"
          ["a@x.com" "alice" "b@x.com" "bob"]]
         (sql/format
          {:insert-into :users
           :columns     [:email :name]
           :values      [["a@x.com" "alice"] ["b@x.com" "bob"]]}))))

(deftest test-cookbook-insert-select
  (is (= ["INSERT INTO archive (id, name) SELECT id, name FROM users WHERE created_at < ?"
          ["2020-01-01"]]
         (sql/format
          {:insert-into :archive
           :columns     [:id :name]
           :query       {:select [:id :name]
                         :from   [:users]
                         :where  [:< :created_at "2020-01-01"]}}))))

(deftest test-cookbook-cte
  (is (= ["WITH active AS (SELECT id FROM users WHERE status = ?) SELECT o.id, o.total FROM orders AS o JOIN active AS a ON o.user_id = a.id"
          ["active"]]
         (sql/format
          {:with   [[:active {:select [:id] :from [:users] :where [:= :status "active"]}]]
           :select [:o/id :o/total]
           :from   [[:orders :o]]
           :join   [[:active :a] [:= :o/user_id :a/id]]}))))

(deftest test-cookbook-window-ranking
  (is (= ["SELECT id, dept, salary, rank() OVER (PARTITION BY dept ORDER BY salary DESC) AS rk FROM employees"
          []]
         (sql/format
          {:select [:id :dept :salary
                    [[:over [:fn :rank] {:partition-by [:dept]
                                         :order-by     [[:salary :desc]]}]
                     :rk]]
           :from   [:employees]}))))

(deftest test-cookbook-named-window
  (is (= ["SELECT id, rank() OVER w AS rk FROM employees WINDOW w AS (PARTITION BY dept ORDER BY salary DESC)"
          []]
         (sql/format
          {:select [:id [[:over [:fn :rank] :w] :rk]]
           :from   [:employees]
           :window [[:w {:partition-by [:dept] :order-by [[:salary :desc]]}]]}))))

(deftest test-cookbook-reserved-words
  (is (= ["SELECT \"user\", \"order\", id FROM \"group\" WHERE \"order\" = ? ORDER BY \"order\" DESC"
          [1]]
         (sql/format
          {:select   ["\"user\"" "\"order\"" :id]
           :from     ["\"group\""]
           :where    [:= [:raw "\"order\""] 1]
           :order-by [["\"order\"" :desc]]}))))

(deftest test-cookbook-reserved-word-in-where-is-a-value
  (is (= ["SELECT id FROM t WHERE ? = ?" ["\"order\"" 1]]
         (sql/format {:select [:id] :from [:t] :where [:= "\"order\"" 1]}))))

(deftest test-cookbook-json-param
  (is (= ["INSERT INTO events (kind, payload) VALUES (?, ?)"
          ["signup" "{\"plan\":\"pro\"}"]]
         (sql/format
          {:insert-into :events
           :columns     [:kind :payload]
           :values      [["signup" (php/json_encode (php-associative-array "plan" "pro"))]]}))))

(deftest test-cookbook-faq-kebab-keyword-fails
  (is (thrown-with-msg? \InvalidArgumentException
                        "Invalid identifier: :created-at. Use a string or [:raw ...] for names outside letters, digits, _ and $"
                        (sql/format {:select [:id] :from [:users] :order-by [[:created-at :desc]]}))))

(deftest test-cookbook-migrate-raw-step-one
  (is (= ["SELECT id, name FROM users WHERE lower(email) = ?" ["a@x.com"]]
         (sql/format
          {:select ["id, name"]
           :from   ["users"]
           :where  [:= [:raw "lower(email)"] "a@x.com"]}))))

(deftest test-cookbook-migrate-raw-step-two
  (is (= ["SELECT id, name FROM users WHERE lower(email) = ?" ["a@x.com"]]
         (sql/format
          {:select [:id :name]
           :from   [:users]
           :where  [:= [:fn :lower :email] "a@x.com"]}))))
